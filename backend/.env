# Application Environment Variables
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
APP_NAME=scholaros-homework-service

# PostgreSQL Database Configuration
POSTGRES_DB=scholaros
POSTGRES_USER=root
POSTGRES_PASSWORD=hA1qpUyS66ssQJkxnlZVICRoJ1ufSiYC
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/scholaros
DATABASE_USERNAME=root
DATABASE_PASSWORD=hA1qpUyS66ssQJkxnlZVICRoJ1ufSiYC

# Hikari Connection Pool Settings
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5
HIKARI_IDLE_TIMEOUT=300000
HIKARI_CONNECTION_TIMEOUT=20000

# Google Gemini AI Provider Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# JWT Authentication Credentials (MUST be a secret high-entropy key in production)
JWT_SECRET=your_secure_random_base64_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Logging Levels
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_WEB=INFO
LOG_LEVEL_SQL=WARN
